server.port=8080
datasource.driverClassName=org.postgresql.Driver
datasource.url=jdbc:postgresql://ohdsi-postgres:5432/ohdsi_webapi
datasource.username=ohdsi-user
datasource.password=ohdsi-password
datasource.dialect=postgresql
datasource.ohdsi.schema=webapi

flyway.datasource.driverClassName=org.postgresql.Driver
flyway.datasource.url=jdbc:postgresql://ohdsi-postgres:5432/ohdsi_webapi
flyway.datasource.username=ohdsi-user
flyway.datasource.password=ohdsi-password
flyway.locations=classpath:db/migration/postgresql

security.token.expiration=43200
security.provider=DisabledSecurity
security.origin=*
security.ssl.enabled=false
security.maxLoginAttempts=3
security.duration.initial=10
security.duration.increment=10